# Polymarket Insider Tracker — Environment Variables
# Copy this file to .env and fill in the values.

# SendGrid API key for email reports
SENDGRID_API_KEY=

# Recipient email for the 12-hour insider reports
REPORT_EMAIL_TO=giorgiotsoupis@gmail.com

# Verified sender email address in SendGrid
REPORT_EMAIL_FROM=

# Flask secret key (generate a random string)
FLASK_SECRET_KEY=

# Detection scan interval in hours (default: 6)
SCAN_INTERVAL_HOURS=6
